# Copy to .env, set permissions to 600, and replace these fictional values.
INBOX_TEND_ADMIN_USERNAME=admin@example.test
INBOX_TEND_ADMIN_PASSWORD_HASH=
# Optional Gmail Web OAuth; see docs/gmail-web.md. Keep real values private.
INBOX_TEND_GOOGLE_CLIENT_ID=
INBOX_TEND_GOOGLE_CLIENT_SECRET=
INBOX_TEND_GOOGLE_REDIRECT_URI=
INBOX_TEND_TOKEN_KEY=
# Optional mail sync tuning (defaults shown): which Gmail search to mirror, how many messages, max attachment size in bytes.
# INBOX_TEND_SYNC_QUERY=in:inbox
# INBOX_TEND_SYNC_MAX_MESSAGES=200
# INBOX_TEND_ATTACHMENT_MAX_BYTES=10485760

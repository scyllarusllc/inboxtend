{
  "name": "inbox-tend-ui",
  "private": true,
  "description": "Build tooling for Inbox Tend's stylesheet. The running app needs only Python: the compiled CSS and the Font Awesome files are committed.",
  "license": "Apache-2.0",
  "scripts": {
    "build:css": "tailwindcss -i static/src/app.css -o static/styles.css --minify",
    "watch:css": "tailwindcss -i static/src/app.css -o static/styles.css --watch",
    "vendor": "node scripts/vendor-assets.mjs"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@tailwindcss/cli": "^4.3.5",
    "flag-icons": "^7.6.0",
    "tailwindcss": "^4.3.5"
  }
}

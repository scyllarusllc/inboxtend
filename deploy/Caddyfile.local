# Local-only development proxy. Start both servers with `make dev-next` first.
# Browse http://localhost:18766 on this VM (or via an SSH tunnel).
{
	admin off
}

http://localhost:18766 {
	bind 127.0.0.1
	reverse_proxy 127.0.0.1:3000 {
		header_up Host 127.0.0.1:3000
		header_up Origin http://127.0.0.1:3000
	}
}

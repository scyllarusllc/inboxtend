# Inbox Tend web app. Adjust WorkingDirectory (and add User=/Group= if you run it unprivileged).
[Unit]
Description=Inbox Tend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/github/inboxtend
Environment=INBOX_TEND_PORT=8765
Environment=PYTHONUNBUFFERED=1
ExecStart=/root/github/inboxtend/.venv/bin/python cli.py serve --port 8765
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
